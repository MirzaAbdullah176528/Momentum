# apps/web — environment variable names only.
# Copy to .env.local for local dev.
# For Vercel: set in Project Settings → Environment Variables.

# Public API URL the browser uses to reach apps/api.
NEXT_PUBLIC_API_URL="http://localhost:8787"

# Better-Auth client baseURL (typically same as NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:8787"
