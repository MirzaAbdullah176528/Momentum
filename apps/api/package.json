{
  "name": "@momentum/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir=dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:apply:local": "wrangler d1 migrations apply momentum-local --local",
    "db:apply:remote": "wrangler d1 migrations apply momentum-local --remote",
    "clean": "rm -rf dist .turbo .wrangler"
  },
  "dependencies": {
    "@momentum/db": "*",
    "@momentum/rating-engine": "*",
    "@momentum/shared-types": "*",
    "better-auth": "^1.6.26",
    "@better-auth/drizzle-adapter": "^1.6.26",
    "hono": "^4.6.14",
    "resend": "^4.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@momentum/config": "*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "wrangler": "^3.99.0"
  }
}
