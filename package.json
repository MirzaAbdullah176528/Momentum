{
  "name": "momentum",
  "version": "0.1.0",
  "private": true,
  "description": "Momentum — a task/habit tracker that computes a daily 0.0-10.0 rating from logged tasks.",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
