    "clean": "rm -rf dist .turbo coverage"
  },
  "devDependencies": {
    "@momentum/config": "*",
    "@momentum/shared-types": "*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
