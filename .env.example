# Momentum — environment variable names only.
# Copy to .env (apps/web) or .dev.vars (apps/api) and fill in real values.
# NEVER commit real secret values to version control.

# === apps/web (Next.js on Vercel) ===
# Set these in Vercel project settings → Environment Variables.

# Public API URL the browser uses to reach apps/api.
NEXT_PUBLIC_API_URL="https://api.momentum.app"

# Better-Auth client baseURL (same as NEXT_PUBLIC_API_URL).
NEXT_PUBLIC_BETTER_AUTH_URL="https://api.momentum.app"


# === apps/api (Cloudflare Workers) ===
# Non-secret vars live in apps/api/wrangler.toml [vars].
# Secrets MUST be set via `wrangler secret put <NAME>` for production
# or in apps/api/.dev.vars for local dev.

# D1 database binding — configured in wrangler.toml, not here.
# DB=<bound at runtime>

# 32+ character random string. Signs Better-Auth session tokens.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public URL of the deployed Worker. Used for cookie domain, CORS, trusted origins.
BETTER_AUTH_URL="http://localhost:8787"

# Resend API key for transactional email (verification, password reset).
# Empty string = dev no-op mode (emails logged to console, not sent).
# Get a key at https://resend.com — must verify the sender domain.
RESEND_API_KEY=""

# Sender address for outgoing emails. Must be verified in Resend.
FROM_EMAIL="Momentum <noreply@your-verified-domain.com>"

# Environment flag: "local" or "production". Controls cookie `secure` flag,
# CORS allow-list, and CSP. Set in wrangler.toml [vars].
APP_ENV="local"
